# Normalize text while preserving Windows command-script requirements.
* text=auto eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.wav binary
*.ogg binary
*.opus binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
