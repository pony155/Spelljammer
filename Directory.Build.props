<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <SpriteForgeRoot Condition="'$(SpriteForgeRoot)' == '' and '$(SPRITEFORGE_ROOT)' != ''">$(SPRITEFORGE_ROOT)</SpriteForgeRoot>
    <SpriteForgeRoot Condition="'$(SpriteForgeRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\SpriteForge'))</SpriteForgeRoot>
    <SpriteForgeNativeDir Condition="'$(SpriteForgeNativeDir)' == ''">$(SpriteForgeRoot)\build\windows-msvc-debug\release\bin</SpriteForgeNativeDir>
  </PropertyGroup>

</Project>
